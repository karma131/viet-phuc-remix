{
  "name": "viet-phuc-remix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"node --env-file-if-exists=.env server/index.js\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "build:hosted": "npm run build && node scripts/build-hosted.mjs && node scripts/validate-hosted.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.0.0",
    "express": "^5.0.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
